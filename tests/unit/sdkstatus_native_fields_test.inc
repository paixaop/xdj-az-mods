static void assert_native_int(unsigned topic, unsigned field, int value) {
    const int *actual = ds_value(&ds.deck[0].current, topic, field);
    assert(actual && *actual == value);
}
static void test_native_unit_receipts(void) {
    ds.enabled = 1;
    struct azstatus_native_receipt load = {.size = sizeof load, .version = 1, .kind = AZN_LOAD, .unit = 11, .epoch = 12, .load_generation = 13, .a = AZN_LOADED, .valid = 1};
    ds_native_apply(&load);
    struct azstatus_native_receipt raw = {.kind = AZN_PLAY, .unit = 21, .valid = 1, .a = 0, .b = 1, .c = 2, .revision = 1};
    ds_native_apply(&raw);
    assert_native_int(AZ_STATUS_TRANSPORT, AZ_STATUS_TRANSPORT_RAW_PLAY_PAUSE, 1);
    uint64_t cut = ds.deck[0].current.sequence;
    raw.b = 0;
    ds_native_apply(&raw);
    assert(ds.deck[0].current.sequence == cut); /* same notification revision is immutable */
    ++raw.revision;
    ds_native_apply(&raw);
    assert_native_int(AZ_STATUS_TRANSPORT, AZ_STATUS_TRANSPORT_RAW_PLAY_PAUSE, 0);
    raw.valid = -1;
    ds_native_apply(&raw);
    assert(cell(AZ_STATUS_TRANSPORT, AZ_STATUS_TRANSPORT_RAW_PLAY_PAUSE)->info.info.availability == AZ_AVAIL_UNSUPPORTED);
    raw.valid = 1;
    ++raw.revision;
    ds_native_apply(&raw);
    assert(!ds_value(&ds.deck[0].current, AZ_STATUS_TRANSPORT, AZ_STATUS_TRANSPORT_RAW_PLAY_PAUSE));
    ++raw.unit;
    raw.revision = 1;
    raw.b = 1;
    ds_native_apply(&raw);
    assert_native_int(AZ_STATUS_TRANSPORT, AZ_STATUS_TRANSPORT_RAW_PLAY_PAUSE, 1);

    struct azstatus_native_receipt key = load;
    key.kind = AZN_KEY_SHIFT;
    key.attempt = 31;
    key.a = 2;
    ds_native_apply(&key);
    assert_native_int(AZ_STATUS_KEY, AZ_STATUS_KEY_SHIFT_SEMITONES, 2);
    key.a = 13;
    ds_native_apply(&key);
    assert(!ds_value(&ds.deck[0].current, AZ_STATUS_KEY, AZ_STATUS_KEY_SHIFT_SEMITONES));
    key.valid = -1;
    ds_native_apply(&key);
    key.valid = 1;
    key.a = -2;
    ds_native_apply(&key);
    assert(!ds_value(&ds.deck[0].current, AZ_STATUS_KEY, AZ_STATUS_KEY_SHIFT_SEMITONES));
    ++key.attempt;
    ds_native_apply(&key);
    assert_native_int(AZ_STATUS_KEY, AZ_STATUS_KEY_SHIFT_SEMITONES, -2);
    key.load_generation--;
    key.a = 4;
    ds_native_apply(&key);
    assert_native_int(AZ_STATUS_KEY, AZ_STATUS_KEY_SHIFT_SEMITONES, -2);

    struct azstatus_native_receipt stems = load;
    stems.kind = AZN_STEMS;
    stems.attempt = ds.deck[0].stem_binding;
    stems.valid = stems.c = AZ_AVAIL_READY;
    stems.a = 1;
    stems.b = 0;
    ds_native_apply(&stems);
    assert_native_int(AZ_STATUS_STEMS, AZ_STATUS_STEMS_AVAILABLE, 1);
    assert_native_int(AZ_STATUS_STEMS, AZ_STATUS_STEMS_ENABLED, 0);
    cut = ds.deck[0].current.sequence;
    stems.a = 2;
    ds_native_apply(&stems);
    assert(ds.deck[0].current.sequence == cut);
    stems.a = 0;
    ++stems.attempt;
    ds_native_apply(&stems);
    assert_native_int(AZ_STATUS_STEMS, AZ_STATUS_STEMS_AVAILABLE, 1); /* wrong binding cannot withdraw the current worker */

    struct azstatus_native_receipt normal = load;
    normal.kind = AZN_TRANSPORT_STATE;
    normal.a = AZ_PLAYBACK_PLAYING;
    normal.valid = AZ_AVAIL_READY;
    ds_native_apply(&normal);
    assert_native_int(AZ_STATUS_TRANSPORT, AZ_STATUS_TRANSPORT_STATE, AZ_PLAYBACK_PLAYING);
    struct azstatus_native_receipt end = load;
    end.kind = AZN_END;
    end.motion_order = end.motion_generation = 1;
    end.a = end.valid = 1;
    ds_native_apply(&end);
    assert_native_int(AZ_STATUS_TRANSPORT, AZ_STATUS_TRANSPORT_STATE, AZ_PLAYBACK_ENDED);
    normal.a = AZ_PLAYBACK_PAUSED;
    ds_native_apply(&normal);
    assert_native_int(AZ_STATUS_TRANSPORT, AZ_STATUS_TRANSPORT_STATE, AZ_PLAYBACK_ENDED);
    end.a = 0;
    ++end.motion_order;
    ds_native_apply(&end);
    assert_native_int(AZ_STATUS_TRANSPORT, AZ_STATUS_TRANSPORT_STATE, AZ_PLAYBACK_PAUSED);
    struct azstatus_native_receipt gap = {.kind = AZN_GAP, .b = AZN_END, .lost_topics = AZ_STATUS_TOPIC(AZ_STATUS_TRANSPORT)};
    ds_native_apply(&gap);
    assert(!ds_value(&ds.deck[0].current, AZ_STATUS_TRANSPORT, AZ_STATUS_TRANSPORT_STATE));
    gap.b = AZN_TRANSPORT_STATE;
    ds_native_apply(&gap);
    assert(!ds_value(&ds.deck[0].current, AZ_STATUS_TRANSPORT, AZ_STATUS_TRANSPORT_STATE));
    ds_native_apply(&normal);
    assert_native_int(AZ_STATUS_TRANSPORT, AZ_STATUS_TRANSPORT_STATE, AZ_PLAYBACK_PAUSED);

    struct azstatus_native_receipt rate = load;
    rate.kind = AZN_RATE;
    rate.attempt = 71;
    rate.valid = rate.b = AZ_AVAIL_READY;
    rate.a = AZ_STATUS_DIRECTION_FORWARD;
    double speed = 1.25;
    memcpy(&rate.points[0].samples, &speed, sizeof speed);
    ds_native_apply(&rate);
    uint64_t provider = cell(AZ_STATUS_TRANSPORT, AZ_STATUS_TRANSPORT_RATE)->info.provider_id;
    gap.b = AZN_RATE;
    ds_native_apply(&gap);
    assert(cell(AZ_STATUS_TRANSPORT, AZ_STATUS_TRANSPORT_RATE)->info.info.availability == AZ_AVAIL_STALE);
    assert(cell(AZ_STATUS_TRANSPORT, AZ_STATUS_TRANSPORT_RATE)->info.provider_id == provider);
    ds_native_apply(&rate);
    assert(*(const double *) ds_value(&ds.deck[0].current, AZ_STATUS_TRANSPORT, AZ_STATUS_TRANSPORT_RATE) == speed);

    struct azstatus_native_receipt loop = load;
    loop.kind = AZN_LOOP;
    loop.reloop = AZN_RELOOP_STALE;
    ds_native_apply(&loop);
    assert(cell(AZ_STATUS_LOOP, AZ_STATUS_LOOP_RELOOP_AVAILABLE)->info.info.availability == AZ_AVAIL_STALE);
    loop.reloop = AZN_RELOOP_DENIED;
    ds_native_apply(&loop);
    assert_native_int(AZ_STATUS_LOOP, AZ_STATUS_LOOP_RELOOP_AVAILABLE, 0);
    loop.reloop = AZN_RELOOP_UNKNOWN;
    ds_native_apply(&loop);
    assert(cell(AZ_STATUS_LOOP, AZ_STATUS_LOOP_RELOOP_AVAILABLE)->info.info.availability == AZ_AVAIL_UNSUPPORTED);
    puts("PASS raw notification editions, owner retirement, key bounds, stem bindings, normal/terminal precedence and provider-preserving recovery");
}
static void test_native_duration_overshoot(void) {
    ds.enabled = 1;
    struct azstatus_native_receipt load = {.size = sizeof load, .version = 1, .kind = AZN_LOAD, .unit = 11, .epoch = 12, .load_generation = 13, .a = AZN_LOADED, .valid = 1};
    ds_native_apply(&load);
    struct azstatus_native_receipt duration = load;
    duration.kind = AZN_DURATION;
    duration.points[0] = (struct azn_point) {AZN_COORD, 100, 100};
    ds_native_apply(&duration);
    az_status_coord_v1 head = {.samples = 104, .rate_hz = 100, .seconds = 1.04};
    struct ds_time_axis clock = {.units_per_second = 100, .window_samples = 1, .window_rate = 100};
    struct ds_field field = ds_native_field(&load, AZ_STATUS_POSITION, AZ_STATUS_POSITION_HEAD, AZ_AVAIL_READY, &head);
    field.clock = &clock;
    assert(ds_native_stamp(0, &field, 1));
    assert(ds_publish(0, load.load_generation, 0, 1, &field, 1, NULL, NULL, 0, 0) == AZ_OK);
    assert(!ds_value(&ds.deck[0].current, AZ_STATUS_POSITION, AZ_STATUS_POSITION_REMAINING_S));
    struct azstatus_native_receipt end = load;
    end.kind = AZN_END;
    end.motion_order = end.motion_generation = 1;
    end.a = end.valid = 1;
    end.points[1] = (struct azn_point) {AZN_COORD, 100, 102};
    end.observed_window_samples = end.from_window_samples = 1;
    end.observed_window_rate = end.from_window_rate = 100;
    ds_native_apply(&end);
    const double *remaining = ds_value(&ds.deck[0].current, AZ_STATUS_POSITION, AZ_STATUS_POSITION_REMAINING_S);
    assert(remaining && compare_timestamps(*remaining, 0., 1, 100, 1) == AZ_TIME_EQUAL);
    end.points[1].samples = 105;
    ++end.motion_order;
    ds_native_apply(&end);
    assert(!ds_value(&ds.deck[0].current, AZ_STATUS_POSITION, AZ_STATUS_POSITION_REMAINING_S));
    puts("PASS remaining time accepts only the declared duration precision and terminal source-sample overshoot");
}
